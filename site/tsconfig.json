{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".react-router/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "~/*": [
        "./app/*"
      ],
      "@/*": [
        "../*"
      ],
      "vexa": [
        "../../agentic-ui/src/index.ts"
      ],
      "vexa/react": [
        "../../agentic-ui/src/react/index.ts"
      ],
      "vexa/protocol": [
        "../../agentic-ui/src/protocol/index.ts"
      ],
      "vexa/core": [
        "../../agentic-ui/src/core/index.ts"
      ],
      "vexa/lib/*": [
        "../../agentic-ui/src/lib/*"
      ],
      "vexa/ui/*": [
        "../../agentic-ui/src/ui/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ]
    }
  }
}
