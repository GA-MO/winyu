# Copy to .env.local for development. Never commit .env.local.

# Required: every model call goes through OpenRouter.
OPENROUTER_API_KEY=
AGENT_MODEL=google/gemini-3.8-flash
OPENROUTER_APP_TITLE=Winyu

# off stops the background jobs (anomaly, forecast, watches, digest), which call the model.
WINYU_SCHEDULER=off

# Hosts an admin may point an MCP connector at, comma-separated. The demo asset register from `bun run connectors:demo` listens on 127.0.0.1:3290.
WINYU_CONNECTOR_HOSTS=127.0.0.1,localhost
# Seals the secrets of console connectors. Any long random string.
WINYU_CONNECTOR_KEY=

# Optional. See docs/deploy.md for the full list.
# WINYU_AUTH=demo
# WINYU_SESSION_SECRET=
# INVESTIGATE_DAILY=1
# WINYU_OTEL_ENDPOINT=http://localhost:4318/v1/traces
